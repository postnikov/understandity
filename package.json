{
  "name": "understandity",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "engines/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @understandity/server\" \"npm run dev -w @understandity/web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run build -w @understandity/web",
    "course:generate": "tsx packages/course/src/cli.ts",
    "course:worlds": "tsx packages/course/src/worlds-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
